# Excel-CSV MCP Server Environment Variables
# Copy this file to .env and add your actual API keys

# AI Provider API Keys (add the ones you want to use)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
OPENAI_API_KEY=sk-your-openai-key-here
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
GEMINI_API_KEY=your-gemini-key-here

# Optional: Customize AI Models (defaults shown)
ANTHROPIC_MODEL=claude-3-haiku-20240307
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_MODEL=deepseek-v3
GEMINI_MODEL=gemini-2.5-pro

# Optional: Custom API Base URLs (leave blank for defaults)
# OPENAI_BASE_URL=https://api.openai.com/v1
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# --- Security -------------------------------------------------------------

# Confine all file reads and writes to one directory. Unset (the default)
# allows any path, which is usually what you want for local desktop use.
# EXCEL_MCP_WORKSPACE_ROOT=/path/to/your/data

# Neutralize CSV cells that a spreadsheet app would evaluate as a formula
# (values starting with = + - @ tab or CR). On by default; set to "off" to
# write raw values instead. Plain numbers are never modified.
# EXCEL_MCP_CSV_FORMULA_GUARD=off
